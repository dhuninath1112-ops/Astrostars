{
  "version": 2,
  "builds": [
    { "src": "server.js",  "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "style.css",  "use": "@vercel/static" },
    { "src": "script.js",  "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/(kundli-report\\.php|api/chat|api/city-search|api/daily-horoscope|api/compatibility)",
      "dest": "server.js"
    },
    { "handle": "filesystem" }
  ]
}

